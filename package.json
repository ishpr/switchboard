{
  "name": "switchboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local agent-to-agent message bus. One daemon, one stdio MCP shim, headless wake for idle CLIs.",
  "bin": {
    "switchboard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/write-build-info.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "switchboard": "node --experimental-strip-types src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
