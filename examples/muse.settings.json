{
  "schema_version": 1,
  "mcpServers": {
    "switchboard": {
      "command": "node",
      "args": ["/absolute/path/to/switchboard/dist/cli.js", "mcp"],
      "env": {
        "SWITCHBOARD_HARNESS": "muse",
        "SWITCHBOARD_NAME": "muse",
        "SWITCHBOARD_SCOPE": "share"
      }
    }
  }
}
