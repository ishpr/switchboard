{
  "mcpServers": {
    "switchboard": {
      "command": "node",
      "args": ["/absolute/path/to/switchboard/dist/cli.js", "mcp"],
      "env": {
        "SWITCHBOARD_HARNESS": "cursor",
        "SWITCHBOARD_NAME": "cursor",
        "SWITCHBOARD_ROLE": "orchestrator",
        "SWITCHBOARD_SCOPE": "share"
      }
    }
  }
}
